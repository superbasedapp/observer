# recipe.env: the pinned inputs of Observer's microVM guest image set
# (sandbox plan v2 13 P4, lane SBX-P4, ledger SBX-BE-4). build.sh reads only
# this file for versions and checksums; a value here is the whole truth.
# Every package comes from one dated Ubuntu archive snapshot, so the same
# recipe yields the same packages; the kernel debs are also checked against
# their own sha256 here. No kernel is compiled: the distro kernel package
# is unpacked. No agent CLI and no agent runtime is installed (D-751 Q38).
# Checksums read from the snapshot's Packages index on 2026-10-24; the
# rootfs versions re-read from the snapshot's noble, noble-updates and
# noble-security indexes after the first live build (2026-10-24).

SNAPSHOT=20261020T000000Z
SNAPSHOT_MIRROR=https://snapshot.ubuntu.com/ubuntu/${SNAPSHOT}
SUITE=noble
# The pockets the rootfs is built from: every pinned version below must be
# in one of them (build.sh checks before it fetches anything, then checks
# the installed rootfs). The security pocket is one: some pinned updates
# are published only there (git 1:2.43.0-1ubuntu7.4 in this snapshot).
POCKETS="${SUITE} ${SUITE}-updates ${SUITE}-security"
COMPONENTS=main,universe
ARCH=amd64

# The kernel and its modules (vmlinuz, virtiofs, vsock, dm-verity).
KERNEL_PKG=linux-image-6.8.0-147-generic
KERNEL_VERSION=6.8.0-147.147
KERNEL_FILE=pool/main/l/linux-signed/linux-image-6.8.0-147-generic_6.8.0-147.147_amd64.deb
KERNEL_SHA256=08432502e565a8a3b4ab13bd8b01788a0a83c9398c8a1e9350f1225991bc4fbb
MODULES_PKG=linux-modules-6.8.0-147-generic
MODULES_VERSION=6.8.0-147.147
MODULES_FILE=pool/main/l/linux/linux-modules-6.8.0-147-generic_6.8.0-147.147_amd64.deb
MODULES_SHA256=3b9188304d600fc35a4f4d1f99751f7ea485bb7f9e0cb87831d4ebf2d3423d9d
KERNEL_RELEASE=6.8.0-147-generic

# The initramfs's shell (static) and the verity tool (with its libraries,
# copied from the rootfs this recipe built).
BUSYBOX_PKG=busybox-static
BUSYBOX_VERSION=1:1.36.1-6ubuntu3.1
BUSYBOX_FILE=pool/main/b/busybox/busybox-static_1.36.1-6ubuntu3.1_amd64.deb
BUSYBOX_SHA256=944b2728f53ceb3916cec2c962873c9951e612408099601751db2a0a5d81e0ed

# The rootfs: a minimal Ubuntu with git and the CA store, each package
# pinned by version (the snapshot fixes the rest of the dependency closure).
ROOTFS_PACKAGES="bash=5.2.21-2ubuntu4 ca-certificates=20260601~24.04.1 git=1:2.43.0-1ubuntu7.4 procps=2:4.0.4-4ubuntu3.3 cryptsetup-bin=2:2.7.0-1ubuntu4.2"

# The guest kernel allows unprivileged user namespaces (Ubuntu's AppArmor
# restriction is off in the guest: the sysctl below is set by the guest
# init), so an agent's own sandbox can nest (N13). The guest init's
# self-test confirms it before the descriptor's flag counts.
GUEST_USERNS=true

# The initramfs modules, in load order (build.sh adds each one's dependency
# closure from modules.dep; reed_solomon is dm-verity's FEC dependency and
# is named so the self-check requires it).
INITRAMFS_MODULES="virtio_blk dm-mod dm-bufio reed_solomon dm-verity fuse virtiofs vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport"

# Tools build.sh needs on the build host (any recent Ubuntu): mmdebstrap
# 1.4 or later in unshare mode (rootless), e2fsprogs 1.47 (mkfs.ext4 -d),
# cryptsetup-bin 2.7 (veritysetup), cpio, dpkg-deb, gzip, sha256sum, curl,
# binutils (readelf), kmod (depmod), zstd and xz-utils.
