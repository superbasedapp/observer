# recipe-debug.env: the debug variant of the microVM guest image set (R-016).
# build.sh --debug reads recipe.env first, then this file. A debug set is
# NEVER shipped: vendorsign signs it only with -debug and a throwaway debug
# key (it refuses the vendor key), the importer takes it only with both
# --debug-set and --debug-key, and a node boots it only under that key.
# It exists so the live checks that need a root-side hook in the guest can
# run on a KVM box: LIN-5 (kill the guest helper) and LIN-8 (remount the
# guest's read-only roots as guest root).

DEBUG_SET=true
# Where the hooks live in the debug rootfs (root-owned, 0755, read-only
# under dm-verity like the rest of the rootfs).
DEBUG_ROOTFS_DIR=/usr/libexec/observer-debug
# The trigger directory the hooks watch, created 1777 on the guest's /tmp
# tmpfs once the guest init has mounted it. The agent user (any uid)
# triggers a hook by creating a file named after it there; the hook never
# reads the file's content, so no command text crosses from the agent to
# root.
DEBUG_TRIGGER_DIR=/tmp/observer-debug
# The hooks, by trigger file name.
DEBUG_HOOKS="kill-guest-helper remount-root"
