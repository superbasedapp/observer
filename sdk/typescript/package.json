{
  "name": "@superbased/sdk",
  "version": "0.2.0",
  "description": "superbased SDK: send LLM-app and agent traces to superbased over OpenTelemetry (OTLP), with scores, experiments, prompts and auto-instrumentation.",
  "license": "Apache-2.0",
  "author": "superbased <contact@superbased.app>",
  "homepage": "https://superbased.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superbasedapp/observer.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "superbased-sdk": "dist/setup/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./register": {
      "types": "./dist/esm/register.d.ts",
      "import": "./dist/esm/register.js",
      "default": "./dist/esm/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/sdk.test.mjs test/admit.test.mjs test/api.test.mjs test/destination.test.mjs test/control.test.mjs test/cost.test.mjs test/vocabulary.test.mjs test/behaviour.test.mjs test/planrefusal.test.mjs test/aigateway.test.mjs test/instrument.test.mjs test/auto.test.mjs test/project.test.mjs test/credfile.test.mjs test/firsttrace.test.mjs test/register.test.mjs test/contract030.test.mjs test/setup.test.mjs test/cjs.test.cjs",
    "test:install": "SUPERBASED_INSTALL_TEST=1 node --test test/install.test.mjs",
    "example": "npm run build && tsc -p examples/tsconfig.json && node examples/dist/quickstart.js",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "llm",
    "agents",
    "tracing",
    "genai"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "import-in-the-middle": "^1.15.0"
  },
  "peerDependencies": {
    "@ai-sdk/otel": "^1.0.0",
    "@arizeai/openinference-instrumentation-anthropic": "^1.0.3",
    "@arizeai/openinference-instrumentation-langchain": "^4.2.1",
    "@arizeai/openinference-instrumentation-mcp": "^0.2.39",
    "@arizeai/openinference-instrumentation-openai": "^4.5.0",
    "@traceloop/instrumentation-google-generativeai": "^0.27.0",
    "@arizeai/openinference-instrumentation-bedrock": "^0.5.10",
    "@traceloop/instrumentation-llamaindex": "^0.27.0",
    "@arizeai/openinference-instrumentation-openai-agents": "^0.3.6"
  },
  "peerDependenciesMeta": {
    "@arizeai/openinference-instrumentation-openai": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-anthropic": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-langchain": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-mcp": {
      "optional": true
    },
    "@ai-sdk/otel": {
      "optional": true
    },
    "@traceloop/instrumentation-google-generativeai": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-bedrock": {
      "optional": true
    },
    "@traceloop/instrumentation-llamaindex": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-openai-agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/otel": "^1.0.177",
    "@anthropic-ai/sdk": "^1.10.0",
    "@arizeai/openinference-instrumentation-anthropic": "^1.0.3",
    "@arizeai/openinference-instrumentation-bedrock": "^0.5.10",
    "@arizeai/openinference-instrumentation-langchain": "^4.2.1",
    "@arizeai/openinference-instrumentation-mcp": "^0.2.39",
    "@arizeai/openinference-instrumentation-openai": "^4.5.0",
    "@arizeai/openinference-instrumentation-openai-agents": "^0.3.6",
    "@aws-sdk/client-bedrock-runtime": "^3.1172.0",
    "@google/genai": "^3.6.1",
    "@langchain/core": "^1.4.2",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.22.0",
    "@traceloop/instrumentation-google-generativeai": "^0.27.0",
    "@traceloop/instrumentation-llamaindex": "^0.27.0",
    "@types/node": "^20.0.0",
    "ai": "^7.0.177",
    "llamaindex": "^0.12.1",
    "openai": "^7.60.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.7"
  }
}
