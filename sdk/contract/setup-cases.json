  "next_steps": {
    "_doc": "Phase 6, the one line and where (SDK quickstart plan section 2.3, sdk-api-surface.md sections 17 and 18). A case's own sdks, when present, narrows the file's (the npm cases name typescript). Inputs: language, esm, nextjs, entry (the entry candidate setup chose). want: init_line (exactly), where (a substring of the placement text), start_script (TypeScript ESM: the flag added to the start command), instrumentation_file (Next.js: the file to add and a substring of it).",
    "cases": [
      {
        "name": "python",
        "language": "python",
        "esm": false,
        "nextjs": false,
        "entry": "app/main.py",
        "want": {
          "init_line": "import superbased_sdk; superbased_sdk.init()",
          "where": "app/main.py"
        }
      },
      {
        "name": "typescript, CommonJS",
        "sdks": ["typescript"],
        "language": "typescript",
        "esm": false,
        "nextjs": false,
        "entry": "src/server.js",
        "want": {
          "init_line": "require(\"@superbased/sdk\").init()",
          "where": "src/server.js"
        }
      },
      {
        "name": "typescript, ESM: the start script, not a line of code",
        "sdks": ["typescript"],
        "language": "typescript",
        "esm": true,
        "nextjs": false,
        "entry": "server.js",
        "want": {
          "init_line": null,
          "start_script": "--import @superbased/sdk/register",
          "where": "package.json"
        }
      },
      {
        "name": "Next.js: instrumentation.ts",
        "sdks": ["typescript"],
        "language": "typescript",
        "esm": false,
        "nextjs": true,
        "entry": null,
        "want": {
          "init_line": null,
          "instrumentation_file": {
            "path": "instrumentation.ts",
            "contains": "await import(\"@superbased/sdk/register\")"
          },
          "where": "instrumentation.ts"
        }
      }
    ]
  },
