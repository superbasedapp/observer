  "no_ai_gateway": {
    "_doc": "SDKQS-10: setup never offers, prints, configures or tests the AI gateway. For every scenario of the device_flow, destination_plan and secrecy sections, and the next phase's text for every detection case, no stdout or stderr line, --json line or next-steps text may contain any forbidden string, compared case-insensitively. The plain word 'gateway' is allowed (the ingest gateway).",
    "forbidden": [
      "ai gateway",
      "ai_gateway",
      "aigateway",
      "gateway_endpoint",
      "gatewayendpoint",
      "openai_client",
      "anthropic_client",
      "openaiclient",
      "anthropicclient",
      "superbased_ai_gateway",
      "/ai/"
    ]
  },
  "no_r165": {
    "_doc": "SDKQS-8: setup never calls the machine's credential routes or runs the person's sign-in verbs (guard R-165 keeps those for the person). Each SDK's test greps its setup module's sources (Python superbased_sdk/_setup/, TypeScript src/setup/) for these strings, case-sensitively; none may appear.",
    "forbidden_in_source": [
      "/api/sdk/credential",
      "sdk sign-in",
      "sdk sign-out",
