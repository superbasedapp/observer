  "first_run_refusals": {
    "_doc": "The five first-run refusals of the SDK quickstart plan section 3.8, read with the SDK's one plan refusal parser. Inputs: stage (redeem or hello), and the answer: fixture (a grant-redeem.json response name) or plan_refusal_case (a name in plan-refusal-cases.json cases; its status, headers and body). want: lines (substrings setup prints, in order: the server's message exactly as sent first, then the setup line), no_line_contains (substrings it must not print), exit, file_written, hello_sent. setup never prints a plan name or a number of its own: the plan's 'more with Personal Pro' line is 'More: <upgrade_url>' here.",
    "cases": [
      {
        "name": "redeem: the chosen team's plan does not include AI Apps",
        "stage": "redeem",
        "fixture": "plan_required",
        "want": {
          "lines": [
            "AI Apps ingest is not part of this organization's plan (Team).",
            "Change the plan: https://cloud.superbased.app/portal/orgs/5d4c3b2a"
          ],
          "exit": 3,
          "file_written": false,
          "hello_sent": false
        }
      },
      {
        "name": "redeem: minted, the month already used",
        "stage": "redeem",
        "fixture": "minted_month_used",
        "want": {
          "lines": [
            "This organization has used this month's AI Apps allowance of its plan (Personal Free)",
            "Ingest resumes 2027-02-01T00:00:00Z. More: https://cloud.superbased.app/portal/billing"
          ],
          "exit": 3,
          "file_written": true,
          "hello_sent": false
        }
      },
      {
        "name": "hello: over the plan's allowance",
        "stage": "hello",
        "plan_refusal_case": "429 events quota over the plan's allowance, with Retry-After",
        "want": {
          "lines": [
            "This organization has used this month's AI Apps allowance of its plan (Team).",
            "Ingest resumes 2026-12-01T00:00:00Z. More: "
          ],
          "exit": 3,
          "file_written": true,
          "hello_sent": true
        }
      },
      {
        "name": "hello: over the organization's own cap (no upgrade_url, not a plan refusal)",
        "stage": "hello",
        "plan_refusal_case": "429 events quota over the org's own cap (no upgrade_url) is not a plan refusal",
        "want": {
          "lines": [
            "This organization has used this month's AI Apps cap.",
            "your organization set this cap itself (Settings > Server > Runtime settings)"
          ],
          "no_line_contains": [
            "More: ",
            "Change the plan"
          ],
          "exit": 3,
          "file_written": true,
          "hello_sent": true
        }
      },
      {
        "name": "hello: a plan with no AI Apps allowance",
        "stage": "hello",
        "plan_refusal_case": "403 plan_required in the SDK control API envelope",
        "want": {
          "lines": [
            "This organization's plan (Starter) includes no AI Apps allowance.",
            "Change the plan: https://superbased.app/pricing"
          ],
          "exit": 3,
          "file_written": true,
          "hello_sent": true
        }
