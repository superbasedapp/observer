{
  "_doc": "The SDK-held credential file (destination.md section 6a; SDK quickstart plan section 3.4, ruling R4): where it is and how the SDK reads it. Every SDK's file reader runs these from 0.2.0 (Python and TypeScript in wave 1, Go and Java in wave 2). path_cases: the path function per OS: os (linux, darwin, windows), env (SUPERBASED_CREDENTIAL_FILE, XDG_CONFIG_HOME, LOCALAPPDATA; absent: unset), home (the OS home directory); want.path is the path (null: no default path, the file is absent). reader_cases: the runner writes text to a fresh temporary path with the attributes given (mode, default 0600 on unix; symlink: the path is a symlink to a valid file; kind: file (default) or directory; owner: self (default) or other, which a runner that cannot chown fakes through its own owner seam; windows: reparse_point, location localappdata (default) or outside, owner_sid self (default) or other) and reads it. os is unix (Linux and macOS), windows, or any. want.state is ok, absent or refused; refused carries reason, a closed vocabulary: symlink, not_regular, mode, owner, too_large, empty, bad_key_line, bad_name_line, reparse_point, outside_localappdata. ok carries the fields read (key_id is the part before the first dot of the key line; the secret is never compared or printed): gateway_url, destination, dashboard_url, expires_at, each null when the line is absent or ignored; ignored lines add the name to want.ignored (a warning for gateway_url and destination, a note for dashboard_url and expires_at). Unknown names are ignored silently. The key in every case is a fake.",
  "since": "0.2.0",
  "sdks": [
    "python",
    "typescript",
    "go",
    "java"
  ],
  "reasons": [
    "symlink",
    "not_regular",
    "mode",
    "owner",
    "too_large",
    "empty",
    "bad_key_line",
    "bad_name_line",
    "reparse_point",
    "outside_localappdata"
  ],
  "path_cases": [
    {
      "name": "linux default",
      "os": "linux",
      "env": {},
      "home": "/home/me",
      "want": {
        "path": "/home/me/.config/superbased/sdk-credential"
      }
    },
    {
      "name": "macOS default (XDG, not Library)",
      "os": "darwin",
      "env": {},
      "home": "/Users/me",
      "want": {
        "path": "/Users/me/.config/superbased/sdk-credential"
      }
    },
    {
      "name": "XDG_CONFIG_HOME",
      "os": "linux",
      "env": {
        "XDG_CONFIG_HOME": "/xdg"
      },
      "home": "/home/me",
      "want": {
        "path": "/xdg/superbased/sdk-credential"
      }
    },
    {
      "name": "a relative XDG_CONFIG_HOME is ignored",
      "os": "linux",
      "env": {
        "XDG_CONFIG_HOME": "relative/dir"
      },
      "home": "/home/me",
      "want": {
        "path": "/home/me/.config/superbased/sdk-credential"
      }
    },
    {
      "name": "an empty XDG_CONFIG_HOME is ignored",
      "os": "darwin",
      "env": {
        "XDG_CONFIG_HOME": ""
      },
      "home": "/Users/me",
      "want": {
        "path": "/Users/me/.config/superbased/sdk-credential"
      }
    },
    {
      "name": "windows default",
      "os": "windows",
      "env": {
        "LOCALAPPDATA": "C:\\Users\\me\\AppData\\Local"
      },
      "home": "C:\\Users\\me",
      "want": {
        "path": "C:\\Users\\me\\AppData\\Local\\superbased\\sdk-credential"
      }
    },
    {
      "name": "windows: XDG_CONFIG_HOME is not read",
      "os": "windows",
      "env": {
        "LOCALAPPDATA": "C:\\Users\\me\\AppData\\Local",
        "XDG_CONFIG_HOME": "C:\\xdg"
      },
      "home": "C:\\Users\\me",
      "want": {
        "path": "C:\\Users\\me\\AppData\\Local\\superbased\\sdk-credential"
      }
    },
    {
      "name": "windows without LOCALAPPDATA: no default path",
      "os": "windows",
      "env": {},
      "home": "C:\\Users\\me",
      "want": {
        "path": null
      }
    },
    {
      "name": "SUPERBASED_CREDENTIAL_FILE replaces the path",
      "os": "linux",
      "env": {
        "SUPERBASED_CREDENTIAL_FILE": "/srv/keys/acme",
        "XDG_CONFIG_HOME": "/xdg"
      },
      "home": "/home/me",
      "want": {
        "path": "/srv/keys/acme"
      }
    },
    {
      "name": "SUPERBASED_CREDENTIAL_FILE on windows",
      "os": "windows",
      "env": {
        "SUPERBASED_CREDENTIAL_FILE": "C:\\Users\\me\\AppData\\Local\\superbased\\acme",
        "LOCALAPPDATA": "C:\\Users\\me\\AppData\\Local"
      },
      "home": "C:\\Users\\me",
      "want": {
        "path": "C:\\Users\\me\\AppData\\Local\\superbased\\acme"
      }
    },
    {
      "name": "a blank SUPERBASED_CREDENTIAL_FILE is unset",
      "os": "linux",
      "env": {
        "SUPERBASED_CREDENTIAL_FILE": "  "
      },
      "home": "/home/me",
      "want": {
        "path": "/home/me/.config/superbased/sdk-credential"
      }
    }
  ],
