        "indicator": {"status": 302, "header_contains": {"Location": "/notes"}}
      }
    },
    {
      "id": "D06",
      "setup": [
        {
          "method": "POST",
          "path": "/api/login",
          "jar": "b",
          "json": {"username": "bob", "password": "fixture-pass-bob"}
