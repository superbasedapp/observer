  ],
  "containment": [
    {
      "id": "K3",
      "name": "fetcher_refuses_the_app_port_and_other_hosts",
      "setup": [
        {
          "method": "POST",
          "path": "/api/login",
          "jar": "a",
          "json": {"username": "alice", "password": "fixture-pass-alice"}
        }
      ],
      "checks": [
        {
          "request": {"method": "POST", "path": "/api/import", "jar": "a", "json": {"url": "http://127.0.0.1:{port}/"}},
          "expect": {"status": 400, "body_contains": ["unsupported address"]}
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/import",
            "jar": "a",
            "json": {"url": "http://example.invalid:{console_port}/"}
          },
          "expect": {"status": 400, "body_contains": ["unsupported address"]}
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/import",
            "jar": "a",
            "json": {"url": "https://127.0.0.1:{console_port}/"}
          },
          "expect": {"status": 400, "body_contains": ["unsupported address"]}
        }
      ]
    },
    {
      "id": "K4",
      "name": "reads_stop_at_the_application_directory",
      "setup": [],
      "checks": [
