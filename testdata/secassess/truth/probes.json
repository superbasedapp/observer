          "request": {"method": "GET", "path": "/download?file=..%2F..%2F..%2F..%2F..%2F..%2Fetc%2Fpasswd"},
          "expect": {"status": 404}
        },
        {
          "request": {"method": "GET", "path": "/download?file=..%2F..%2Fnotes.sqlite.seed.sql"},
          "expect": {"status": 404}
        }
      ]
    }
  ]
