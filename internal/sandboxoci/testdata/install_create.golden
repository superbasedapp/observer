    "Cmd": [],
    "Image": "node@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "WorkingDir": "/tmp",
    "Labels": {
      "app.superbased.observer.install": "inst000000000001",
      "app.superbased.observer.role": "sandbox",
      "app.superbased.observer.run": "run0000000000000001"
    },
    "StopSignal": "SIGTERM",
    "StopTimeout": 10,
    "HostConfig": {
      "NetworkMode": "none",
      "CapDrop": [
        "ALL"
      ],
      "CapAdd": [],
