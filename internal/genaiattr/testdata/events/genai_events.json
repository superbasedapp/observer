      "want": {
        "bodies": [
          {"kind": "prompt", "raw": "[{\"parts\":[{\"content\":\"Weather in Paris?\",\"type\":\"text\"}],\"role\":\"user\"}]"},
          {"kind": "response", "raw": "[{\"finish_reason\":\"stop\",\"parts\":[{\"content\":\"Sunny.\",\"type\":\"text\"}],\"role\":\"assistant\"}]"},
          {"kind": "system_instructions", "raw": "[{\"content\":\"Be brief.\",\"type\":\"text\"}]"}
        ]
      }
    },
    {
      "name": "legacy_system_message_kvlist",
      "event": "gen_ai.system.message",
