      "want": {"messages": [{"kind": "prompt", "json": {"role": "assistant", "tool_calls": [{"function": {"arguments": "{\"city\":\"Paris\"}", "name": "get_weather"}, "id": "call_1", "type": "function"}]}}]}
    },
    {
      "name": "legacy_tool_message_keeps_its_role",
