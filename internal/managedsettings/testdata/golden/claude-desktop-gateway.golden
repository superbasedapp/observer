===== cowork/managed-settings.json (file) =====
{
  "inferenceCredentialHelper": "/usr/local/bin/org-gateway-key",
  "inferenceCredentialHelperArgs": [
    "--profile",
    "observer"
  ],
  "inferenceCredentialHelperWindows": "C:\\Program Files\\Org\\gateway-key.exe",
  "inferenceCredentialKind": "helper-script",
  "inferenceGatewayAuthScheme": "x-api-key",
  "inferenceGatewayBaseUrl": "http://127.0.0.1:8820",
  "inferenceProvider": "gateway"
}

